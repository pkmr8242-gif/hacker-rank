#include <stdio.h>
#include <string.h>

int main() {
    char str[1000];

    // Read the entire line
    fgets(str, sizeof(str), stdin);

    // Split the string into words
    char *word = strtok(str, " \n");

    while (word != NULL) {
        printf("%s\n", word);
        word = strtok(NULL, " \n");
    }

    return 0;
}
